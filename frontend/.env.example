# Optional. URL of your deployed summary proxy (proxy/, holds the Gemini key
# server-side). Set this and the "Plain-English summary" is written by Gemini;
# leave it blank and a built-in generated summary is used instead — the
# predictor itself is unaffected either way.
#
#   local:  VITE_PROXY_URL=http://localhost:8787
#   prod :  set it as an Environment Variable on the Vercel project
VITE_PROXY_URL=
